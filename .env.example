APP_NAME=mailmm
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=warning

MAILBOX_DOMAIN=mailmm.test
MX_HOST=mx.mailmm.test
MX_PREVIOUS_HOSTS=
MAILBOX_MAX_MESSAGE_BYTES=10485760
HTTP_BIND=127.0.0.1:8080
HTTPS_BIND=443
SMTP_BIND=127.0.0.1:2525

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=mailmm
DB_USERNAME=mailmm
DB_PASSWORD=
PG_ADMIN_PASSWORD=
SMTP_LOOKUP_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=mailmm
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
MAIL_MAILER=log
