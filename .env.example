APP_NAME=mailmm
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=warning

MAILBOX_DOMAIN=mailmm.test
MX_HOST=mx.mailmm.test
MX_PREVIOUS_HOSTS=
MAILBOX_MAX_MESSAGE_BYTES=10485760
HTTP_BIND=127.0.0.1:8080
HTTPS_BIND=443
SMTP_BIND=127.0.0.1:2525

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=mailmm
DB_USERNAME=mailmm
DB_PASSWORD=
PG_ADMIN_PASSWORD=
SMTP_LOOKUP_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=mailmm
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
MAIL_MAILER=log

# Forwarding enablement timestamps use UTC. Rotate the respective epoch when re-enabling.
FORWARD_MANUAL_ENABLED=false
FORWARD_AUTO_ENABLED=false
FORWARD_MANUAL_ENABLED_AT=
FORWARD_AUTO_ENABLED_AT=
FORWARD_SERVICE_ADDRESS=
FORWARD_BOUNCE_DOMAIN=
# Verification codes use MANUAL_DSN. Manual and automatic copies use the ARC relay at AUTO_DSN.
FORWARD_MANUAL_DSN=
FORWARD_AUTO_DSN=
FORWARD_WEBHOOK_SECRET=
FORWARD_SCANNER_URL=http://forward-filter:11333/checkv2
